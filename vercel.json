{
  "version": 2,
  "builds": [
    { "src": "api/index.js", "use": "@vercel/node" },
    { "src": "api/faculty.js", "use": "@vercel/node" },
    { "src": "api/dont001.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/DONT@001", "dest": "api/dont001.js" },
    { "src": "/DONT@001/(.*)", "dest": "api/dont001.js" },
    { "src": "/faculty", "dest": "api/faculty.js" },
    { "src": "/faculty/(.*)", "dest": "api/faculty.js" },
    { "src": "/(.*)", "dest": "api/index.js" }
  ]
}
